{
  "name": "relay-chat-widget",
  "version": "0.1.0",
  "description": "Embeddable floating chat widget for Relay RAG chatbots. Drop it into any website via a script tag or install as an npm package.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "chatbot",
    "widget",
    "embed",
    "rag",
    "chat-widget",
    "customer-support"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratik-kamble-pk/relay.git",
    "directory": "chatbot-widget"
  },
  "bugs": {
    "url": "https://github.com/pratik-kamble-pk/relay/issues"
  },
  "homepage": "https://github.com/pratik-kamble-pk/relay/tree/main/chatbot-widget#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "build:copy-local": "tsup && node -e \"require('fs').copyFileSync('dist/index.global.js', '../nextjs-app/public/widget.js')\""
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.8.3"
  }
}
