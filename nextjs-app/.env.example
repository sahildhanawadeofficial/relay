MONGODB_URI=mongodb://localhost:27017/chatbot-platform
AUTH_SECRET=your-auth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Pinecone Vector DB & Native Embeddings
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=chatbot-platform
PINECONE_INDEX_HOST=your-pinecone-index-host
PINECONE_NAMESPACE=default
PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# OpenRouter — used to generate a proper, conversationally-framed answer from
# the matched Pinecone chunks (instead of returning raw matched text), using
# OpenRouter's free-tier models (no cost, rate-limited).
# Get a key at https://openrouter.ai/keys (should look like "sk-or-v1-...")
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Comma-separated automatic fallback models if the primary is rate-limited/down.
# openrouter/free auto-picks any currently healthy free model as a last resort.
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-120b:free,deepseek/deepseek-r1:free,openrouter/free

# Google OAuth — get these from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
